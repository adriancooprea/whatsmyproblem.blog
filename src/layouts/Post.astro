---
import Base from './Base.astro';
import Metadata from '../components/Metadata.astro';
import { getCollection } from 'astro:content';
import { padNumber, formatMonthShort } from '../lib/format';

interface Perspective {
  voice: string;
  claim: string;
  body: string;
}
interface Props {
  number: number;
  title: string;
  subtitle?: string;
  date: Date;
  readingTime: number;
  slug: string;
  perspectives?: Perspective[];
}
const { number, title, subtitle, date, readingTime, slug, perspectives } = Astro.props;

const all = (await getCollection('posts'))
  .filter(p => !p.data.draft)
  .sort((a, b) => a.data.date.getTime() - b.data.date.getTime());
const idx = all.findIndex(p => p.id === slug);
const prev = idx > 0 ? all[idx - 1] : null;
const next = idx >= 0 && idx < all.length - 1 ? all[idx + 1] : null;
---
<Base title={`${title} — What's My Problem?`}>
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-gutter">
    <!-- The Confession -->
    <article class="lg:col-span-8 cage-border p-gutter md:p-margin bg-surface-dim">
      <header class="mb-margin cage-border-bottom pb-gutter">
        <h1 class="font-headline-xl text-headline-xl md:text-[64px] text-on-surface mb-4 leading-none">{title}</h1>
        {subtitle && <p class="font-body-lg text-body-lg italic text-on-surface-variant mb-4">{subtitle}</p>}
        <Metadata number={number} date={date} readingTime={readingTime} />
      </header>

      <div class="prose font-body-md text-body-md text-on-surface" data-prose>
        <slot />
      </div>
    </article>

    <!-- Side rail -->
    <aside class="lg:col-span-4 flex flex-col gap-gutter">
      {perspectives && perspectives.length > 0 && perspectives.map((p, i) => (
        <div class={`p-gutter ${i % 2 === 1 ? 'cage-border-heavy bg-surface-container-highest' : 'cage-border bg-surface-container-low'}`}>
          <div class="font-label-md text-label-md uppercase text-error mb-4 pb-2 cage-border-bottom">{p.voice}</div>
          <div class="font-headline-lg-mobile text-headline-lg-mobile text-on-surface mb-2">{p.claim}</div>
          <p class="font-caption text-caption text-on-surface-variant">{p.body}</p>
        </div>
      ))}
      <div class="cage-border p-gutter bg-background flex justify-center items-center h-48">
        <span class="font-headline-lg-mobile text-headline-lg-mobile uppercase text-on-surface-variant">No Exit</span>
      </div>
    </aside>
  </div>

  <!-- Prev / next -->
  <nav class="mt-margin cage-border-top pt-gutter grid grid-cols-1 sm:grid-cols-2 gap-gutter">
    <div>
      {prev && (
        <a href={`/posts/${prev.id}`} class="block group">
          <div class="font-label-md text-label-md uppercase text-on-surface-variant mb-1 group-hover:text-error transition-colors">← No. {padNumber(prev.data.number)} · {formatMonthShort(prev.data.date)}</div>
          <div class="font-body-lg text-body-lg text-on-surface group-hover:text-error transition-colors">{prev.data.title}</div>
        </a>
      )}
    </div>
    <div class="sm:text-right">
      {next && (
        <a href={`/posts/${next.id}`} class="block group">
          <div class="font-label-md text-label-md uppercase text-on-surface-variant mb-1 group-hover:text-error transition-colors">No. {padNumber(next.data.number)} · {formatMonthShort(next.data.date)} →</div>
          <div class="font-body-lg text-body-lg text-on-surface group-hover:text-error transition-colors">{next.data.title}</div>
        </a>
      )}
    </div>
  </nav>
</Base>

<script>
  // Footnotes: inline expand. Source HTML is from our own .md at build time.
  function transformFootnotes() {
    const prose = document.querySelector('[data-prose]') as HTMLElement | null;
    if (!prose) return;
    const section = prose.querySelector('section[data-footnotes], section.footnotes') as HTMLElement | null;
    if (!section) return;

    const fragments: Record<string, DocumentFragment> = {};
    const items = Array.from(section.querySelectorAll('li')) as HTMLLIElement[];
    items.forEach(li => {
      const frag = document.createDocumentFragment();
      Array.from(li.childNodes).forEach(n => frag.appendChild(n.cloneNode(true)));
      frag.querySelectorAll('a.data-footnote-backref, a[data-footnote-backref], .data-footnote-backref').forEach(a => a.remove());
      fragments[li.id] = frag;
    });

    const refs = Array.from(
      prose.querySelectorAll('sup a[data-footnote-ref], sup a[href^="#user-content-fn-"], sup a[href^="#fn"]')
    ) as HTMLAnchorElement[];

    refs.forEach((a, i) => {
      const target = (a.getAttribute('href') || '').replace(/^#/, '');
      const frag = fragments[target] || fragments[`user-content-${target}`];
      if (!frag) return;
      const sup = a.parentElement as HTMLElement;
      const marker = String(i + 1);
      a.textContent = marker;
      a.classList.add('fn-ref');

      const wrap = document.createElement('span');
      wrap.className = 'fn-inline';
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'fn-toggle';
      btn.setAttribute('aria-expanded', 'false');
      btn.textContent = 'show note';
      const inline = document.createElement('span');
      inline.className = 'fn-inline-body';
      inline.hidden = true;
      inline.appendChild(frag.cloneNode(true));
      wrap.appendChild(btn);
      wrap.appendChild(inline);
      btn.addEventListener('click', () => {
        const open = btn.getAttribute('aria-expanded') === 'true';
        btn.setAttribute('aria-expanded', String(!open));
        inline.hidden = open;
        btn.textContent = open ? 'show note' : 'hide note';
      });
      sup.insertAdjacentElement('afterend', wrap);
    });

    section.remove();
  }
  transformFootnotes();
  document.addEventListener('astro:after-swap', transformFootnotes);
</script>

<style is:global>
  .fn-inline { margin-left: 0.25em; font-size: 0.78rem; }
  .fn-inline .fn-toggle {
    font-family: var(--font-label-md);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-on-surface-variant);
    background: transparent;
    border: 1px solid var(--color-cage);
    padding: 0.05em 0.4em;
    cursor: pointer;
  }
  .fn-inline-body {
    display: block;
    margin: 0.5em 0 0.5em 0.5em;
    padding-left: 0.75rem;
    border-left: 1px solid var(--color-cage);
    color: var(--color-on-surface-variant);
    font-size: 0.9rem;
  }
  .fn-inline-body p { margin: 0; }
</style>
