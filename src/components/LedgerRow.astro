---
import { padNumber } from '../lib/format';

interface Props {
  number: number;
  date: Date;
  title: string;
  slug: string;
  pullQuote: string;
  last?: boolean;
}
const { number, title, slug, pullQuote, last = false } = Astro.props;
---
<a
  href={`/posts/${slug}`}
  class={`group flex flex-col md:flex-row hover:bg-surface-container-high transition-colors ${last ? '' : 'cage-border-bottom'}`}
>
  <div class="md:w-32 p-4 md:p-6 cage-border-right flex items-center justify-center bg-surface-dim group-hover:bg-transparent transition-colors">
    <span class="font-label-md text-label-md uppercase text-outline">No. {padNumber(number)}</span>
  </div>
  <div class="flex-1 p-4 md:p-6 flex flex-col justify-center">
    <h3 class="font-body-lg text-body-lg text-on-surface group-hover:text-error transition-colors">{title}</h3>
    <p class="font-caption text-caption text-on-surface-variant mt-1">{pullQuote}</p>
  </div>
  <div class="hidden md:flex p-6 items-center justify-end">
    <span class="material-symbols-outlined text-outline group-hover:text-error transition-colors">chevron_right</span>
  </div>
</a>
