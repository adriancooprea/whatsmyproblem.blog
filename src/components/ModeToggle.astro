---
// Hairline toggle. Label switches: "Cell" while in Night, "Night" while in Cell.
// May be rendered multiple times (mobile bar + sidebar); all instances sync.
---
<button
  type="button"
  data-mode-toggle
  aria-label="Toggle color mode"
  class="font-label-md text-label-md uppercase inline-flex items-center gap-2 border border-outline-variant px-3 py-1 leading-none text-on-surface-variant hover:border-error hover:text-error transition-colors"
>
  <span aria-hidden="true" class="material-symbols-outlined text-base">contrast</span>
  <span data-mode-label>Cell</span>
</button>

<script is:inline>
  (() => {
    const root = document.documentElement;
    const sync = () => {
      const mode = root.getAttribute('data-mode') || 'night';
      const text = mode === 'cell' ? 'Night' : 'Cell';
      document.querySelectorAll('[data-mode-label]').forEach(el => { el.textContent = text; });
    };
    const bind = () => {
      document.querySelectorAll('[data-mode-toggle]').forEach(btn => {
        if (btn.dataset.bound) return;
        btn.dataset.bound = '1';
        btn.addEventListener('click', () => {
          const next = root.getAttribute('data-mode') === 'cell' ? 'night' : 'cell';
          root.setAttribute('data-mode', next);
          try { localStorage.setItem('wmp-mode', next); } catch {}
          sync();
        });
      });
    };
    bind();
    sync();
    document.addEventListener('astro:after-swap', () => { bind(); sync(); });
  })();
</script>
