---
import Base from '../layouts/Base.astro';
import LedgerRow from '../components/LedgerRow.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts'))
  .filter(p => !p.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const byYear = new Map<number, typeof posts>();
for (const p of posts) {
  const y = p.data.date.getUTCFullYear();
  if (!byYear.has(y)) byYear.set(y, []);
  byYear.get(y)!.push(p);
}
const years = Array.from(byYear.keys()).sort((a, b) => b - a);
---
<Base title="Archive — What's My Problem?">
  <section class="column-wide">
    <h1 class="display text-3xl sm:text-4xl mb-10 text-[var(--ink)]">Archive</h1>
    {years.map(year => (
      <div class="mb-12">
        <h2 class="display text-2xl mb-2 text-[var(--ink)]">{year}</h2>
        {byYear.get(year)!.map(p => (
          <LedgerRow
            number={p.data.number}
            date={p.data.date}
            title={p.data.title}
            slug={p.id}
            pullQuote={p.data.pull_quote}
          />
        ))}
        <div class="border-t border-[var(--rule)]"></div>
      </div>
    ))}
  </section>
</Base>
