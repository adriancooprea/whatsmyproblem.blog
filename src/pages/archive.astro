---
import Base from '../layouts/Base.astro';
import LedgerRow from '../components/LedgerRow.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts'))
  .filter(p => !p.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const byYear = new Map<number, typeof posts>();
for (const p of posts) {
  const y = p.data.date.getUTCFullYear();
  if (!byYear.has(y)) byYear.set(y, []);
  byYear.get(y)!.push(p);
}
const years = Array.from(byYear.keys()).sort((a, b) => b - a);
---
<Base title="The Underground — What's My Problem?">
  <div class="flex items-center justify-between cage-border-bottom pb-2 mb-margin">
    <h1 class="font-label-md text-label-md uppercase text-on-surface">The Underground — Full Archive</h1>
    <span class="w-2 h-2 bg-error-container" aria-hidden="true"></span>
  </div>

  {years.length === 0 && (
    <p class="font-caption text-caption text-outline italic py-8">The underground is empty. Nothing has been buried yet.</p>
  )}

  {years.map(year => (
    <section class="mb-margin">
      <h2 class="font-headline-lg text-headline-lg text-on-surface mb-4">{year}</h2>
      <div class="flex flex-col cage-border">
        {byYear.get(year)!.map((p, i) => (
          <LedgerRow
            number={p.data.number}
            date={p.data.date}
            title={p.data.title}
            slug={p.id}
            pullQuote={p.data.pull_quote}
            last={i === byYear.get(year)!.length - 1}
          />
        ))}
      </div>
    </section>
  ))}
</Base>
